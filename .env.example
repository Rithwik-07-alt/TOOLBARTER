# ==============================================================================
# TOOLBARTER Environment Variables Template
# Copy this file to .env (or set the variables in your OS / terminal environment)
# DO NOT COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/defaultdb?ssl-mode=REQUIRED
DB_USERNAME=your_aiven_username
DB_PASSWORD=your_aiven_password

# JPA / Hibernate Schema Control (Options: validate, update, none)
JPA_DDL_AUTO=update

# Application Server Port
SERVER_PORT=8080

# JWT Authentication Secret (for Phase 4)
# JWT_SECRET=your_jwt_256_bit_secret_key_here
