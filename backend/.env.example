# ==============================================================================
# TOOLBARTER Backend Environment Variables Template
# Copy this file to .env or set environment variables in your environment
# DO NOT COMMIT SENSITIVE PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/toolbarter?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Hibernate / JPA Schema Management (update | validate | none)
JPA_DDL_AUTO=update

# Server Port
SERVER_PORT=8080

# JWT Security Configuration (Key must be at least 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
